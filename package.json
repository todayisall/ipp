{
  "name": "ipp-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter=@ipp/protocol --filter=@ipp/codec --filter=@ipp/client --filter=@ipp/transport-fetch --filter=@ipp/transport-harmony build",
    "test": "pnpm build && vitest run",
    "test:watch": "vitest",
    "lint": "biome check packages",
    "format": "biome format --write packages",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
